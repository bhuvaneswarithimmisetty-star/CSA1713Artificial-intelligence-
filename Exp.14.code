# Decision Tree Classification

data = [
    [1, 1, "Yes"],
    [1, 0, "Yes"],
    [0, 1, "No"],
    [0, 0, "No"]
]

print("Decision Tree Classification")
print("Feature1  Feature2  Output")

for row in data:
    print(row[0], "       ", row[1], "       ", row[2])

f1 = int(input("Enter Feature 1 (0 or 1): "))
f2 = int(input("Enter Feature 2 (0 or 1): "))

if f1 == 1:
    result = "Yes"
else:
    result = "No"

print("Predicted Class:", result)
